{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/zero_execute_request_v6.schema.json",
  "title": "ZeroExecuteRequestV6",
  "type": "object",
  "required": ["abi_version", "task_contract_root", "operation", "side_effect_policy"],
  "properties": {
    "abi_version": {"const": "zerostack.racc.v6"},
    "task_contract_root": {"type": "string", "minLength": 16},
    "project_root": {"type": ["string", "null"]},
    "continuation_handle": {"type": ["string", "null"]},
    "operation": {"enum": ["inspect", "explain", "plan", "edit", "refactor", "port", "build", "test", "verify", "resume", "cancel"]},
    "objective": {"type": ["string", "null"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "decision": {},
    "contingent_policy": {},
    "side_effect_policy": {"enum": ["read_only", "sandbox_only", "verified_commit", "human_commit"]},
    "private_composition_budget": {
      "type": "object",
      "properties": {
        "max_operations": {"type": "integer", "minimum": 0},
        "max_wall_ms": {"type": "integer", "minimum": 0},
        "max_complete_work_units": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "model_contract_root": {"type": ["string", "null"]},
    "harness_contract_root": {"type": ["string", "null"]},
    "tool_contract_root": {"type": ["string", "null"]},
    "reasoning_contract_root": {"type": ["string", "null"]},
    "verification_contract_root": {"type": ["string", "null"]},
    "result_detail": {"enum": ["minimal", "decision", "audit", "full"]}
  },
  "additionalProperties": false
}
