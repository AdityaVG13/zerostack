{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/zero_execute_result_v6.schema.json",
  "title": "ZeroExecuteResultV6",
  "type": "object",
  "required": ["abi_version", "kind", "audit_event_range", "resource_ledger_root"],
  "properties": {
    "abi_version": {"const": "zerostack.racc.v6"},
    "kind": {"enum": ["Completed", "DecisionRequired", "EvidenceExpansionRequired", "VerificationUnknown", "BaselineFallbackRequired", "RejectedNoMutation"]},
    "continuation_handle": {"type": ["string", "null"]},
    "project_root": {"type": ["string", "null"]},
    "successor_root": {"type": ["string", "null"]},
    "decision_view_root": {"type": ["string", "null"]},
    "result_root": {"type": ["string", "null"]},
    "exact_delta_root": {"type": ["string", "null"]},
    "verification_receipt_root": {"type": ["string", "null"]},
    "successor_certificate_root": {"type": ["string", "null"]},
    "resource_ledger_root": {"type": "string"},
    "cache_report_root": {"type": ["string", "null"]},
    "question": {"type": ["string", "null"]},
    "choices": {"type": "array"},
    "unknown_reasons": {"type": "array", "items": {"type": "string"}},
    "no_mutation_receipt_root": {"type": ["string", "null"]},
    "audit_event_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
