{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/implementation_requirement_v6.schema.json",
  "title": "ImplementationRequirementV6",
  "type": "object",
  "required": ["id", "subsystem", "priority", "title", "requirement", "acceptance_test", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^ZS-[A-Z]+-[0-9]{3}$"},
    "subsystem": {"type": "string"},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "title": {"type": "string"},
    "requirement": {"type": "string"},
    "depends_on": {"type": "string"},
    "theorem": {"type": "string"},
    "acceptance_test": {"type": "string"},
    "status": {"type": "string"}
  },
  "additionalProperties": false
}
