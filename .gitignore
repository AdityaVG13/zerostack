fuzz/artifacts/
fuzz/target/
fuzz/coverage/
fuzz/corpus/*/[0-9a-f]*
scripts/__pycache__/
__pycache__/
*.py[cod]

# Artifacts stay on disk; never publish
/artifacts/
tests/artifacts/
tests/reports/
.ubs-loop/


# Local bench-history ratchet (dotfile, not public).
.bench-history/

