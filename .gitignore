# =============================================================================
# ZeroStack — .gitignore (public hub)
# =============================================================================

# --- Build / test output ---
target/
dist/
build/
node_modules/
coverage/
tmp/
.tmp/
*.log
*.samply
**/Cargo.lock

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*
.secrets/

# --- OS / editors / harnesses ---
.DS_Store
**/.DS_Store
.idea/
.vscode/
.cursor/
.claude/
.pi-subagents/
slate.json
videos/
log.txt
.ubsignore

# --- Engine / CodeMode local stores (never publish) ---
.zerostack/
.fszero/
.graphzero/
.tokenzero/
.asgrep/
blobs/
**/plan-journals/
**/*.journal
**/*.lock
**/ledger.jsonl*
**/recovery-cache.json*
**/boot-manifest.json
**/boot-session-delta.json
**/codemode-recovery.json
**/tool-metrics.json
**/session-memory.json

# --- Agent law (private; live on disk, never remote) ---
AGENTS.md
Agents.md
CLAUDE.md
Claude.md
AGENTS.md.*
CLAUDE.md.*
.papercuts.jsonl
.skill-loop-progress.md

.dolt/
.beads-credential-key
.bv/

# --- Local audit / campaign workspaces ---
.agent-locks.json
.agent-locks.json.tmp
.unsafe-audit/
.ubs/
.ub-exorcism/
.cut-branches/
.prosecution/
/beads_compliance_audit/
beads_compliance_audit/

# --- Historical / internal (local only) ---
archive/
docs/adr/
docs/internal/
benchmarks/
packages/
reports/
fuzz/
scripts/dev/
scripts/__pycache__/
__pycache__/
*.py[cod]

# Private local runtime evidence; not a repository/CI attestation.
conformance/reports/

# Conformance allowlist: ship contracts/schemas/models + topology suite only
conformance/*
!conformance/
!conformance/CONTRACT.md
!conformance/authority/
!conformance/authority/**
!conformance/engine-topology-v1.json
!conformance/models/
!conformance/models/**
!conformance/schemas/
conformance/schemas/*
!conformance/schemas/engine-topology-v1.schema.json
!conformance/schemas/reasoning-contract-v1.schema.json
!conformance/schemas/dominance-complete-recovery-v1.schema.json
!conformance/schemas/exact-deoptimization-resume-v1.schema.json
!conformance/schemas/exact-deoptimization-execution-v1.schema.json
!conformance/schemas/exact-deoptimization-plan-v1.schema.json
!conformance/schemas/q99-causal-cache-component-v1.schema.json
!conformance/schemas/q99-claim-v1.schema.json
!conformance/schemas/robust-snap-intake-v1.schema.json
!conformance/schemas/causal-artifact-intake-v1.schema.json
!conformance/schemas/reinvestment-plan-v1.schema.json
!conformance/schemas/reinvestment-selection-v1.schema.json
!conformance/schemas/zerobench-r-run-v1.schema.json
!conformance/schemas/zerobench-r-report-v1.schema.json
!conformance/tests/
conformance/tests/*
!conformance/tests/test_engine_topology.py

# Local bench history
.bench-history/

# --- Beads (local only; never publish tracker state) ---
.bv/
!conformance/schemas/two-phase-gate-v1.schema.json
!conformance/src/
