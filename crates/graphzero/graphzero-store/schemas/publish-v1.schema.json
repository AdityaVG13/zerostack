{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphzero.local/schemas/publish/v1",
  "title": "GraphZero publish/v1 edge batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publisher", "edges"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "publish/v1"
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$",
      "description": "Namespaced publisher id (lowercase start, 3-64 chars)"
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "dst", "kind", "evidence_ref", "confidence"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "dst": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "pattern": "^gz://blob/[0-9a-f]{64}#B[0-9]+-[0-9]+$" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,63}$"
        }
      }
    }
  }
}