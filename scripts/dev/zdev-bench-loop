#!/usr/bin/env bash
# zdev-bench-loop: emit the one-call batched worker loop benchmark plan.
# Usage: zdev-bench-loop            # print the plan; paste as a single zero_execute plan
# Proves find + read + edit + targeted test + revert in ONE zero_execute call.
set -euo pipefail
cat <<'PLAN'
const t0 = Date.now();
const marks = {};
const mark = (k) => { marks[k] = Date.now() - t0; };
const FILE = 'crates/zerostack-machine-permit/src/lib.rs';

// 1. find the symbol
const found = await zero.token.shell("cd /Users/aditya/AI/ZeroStack && grep -n 'pub fn permit_backoff' " + FILE, {});
mark('found');

// 2. read it
const read = await zero.token.shell("cd /Users/aditya/AI/ZeroStack && sed -n '1376,1392p' " + FILE, {});
mark('read');

// 3. trivial reversible edit (comment text only)
const edited = await zero.token.shell("cd /Users/aditya/AI/ZeroStack && perl -pi -e 's{// 20, 40, 80, 160, 200, 200, \.\.\.}{// 20, 40, 80, 160, 200, 200, ... (bench marker)}' " + FILE + " && grep -c 'bench marker' " + FILE, {});
mark('edited');

// 4. one targeted test (prewarmed: cargo test -p ... --no-run beforehand)
const test = await zero.token.shell("cd /Users/aditya/AI/ZeroStack && cargo test -p zerostack-machine-permit --lib permit_backoff 2>&1 | tail -5", {});
mark('test');

// 5. scoped revert + prove clean
const reverted = await zero.token.shell("cd /Users/aditya/AI/ZeroStack && git checkout -- " + FILE + " && git status --porcelain " + FILE + " | wc -l", {});
mark('reverted');

return { marks, totalMs: Date.now() - t0, found, read, edited, test, reverted };
PLAN
