#!/usr/bin/env bash
# zdev-status: one-shot dev snapshot of all four zerostack repos
set -uo pipefail
REPOS="${*:-FSZero GraphZero TokenZero ZeroStack}"
for R in $REPOS; do
  D="$HOME/AI/$R"
  [ -d "$D" ] || continue
  cd "$D"
  HEAD=$(git rev-parse --short HEAD 2>/dev/null || echo "-")
  DIRTY=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  OPEN=$(br list 2>/dev/null | grep -c '^○' || echo 0)
  INPROG=$(br list --status in_progress 2>/dev/null | grep -c '\[' || echo 0)
  echo "== $R @ $HEAD dirty=$DIRTY open=$OPEN in_progress=$INPROG"
  br ready --limit 3 2>/dev/null | head -3 | sed 's/^/   /'
  IP=$(br list --status in_progress 2>/dev/null | head -3)
  [ -n "$IP" ] && echo "$IP" | sed 's/^/   IP: /'
done
exit 0
