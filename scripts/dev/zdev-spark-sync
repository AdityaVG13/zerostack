#!/usr/bin/env bash
# zdev-spark-sync <RepoName> [dest-suffix]: tar (source only: no target/.git/store dirs) -> ATP tcp -> extract on spark
set -euo pipefail
R="${1:?usage: zdev-spark-sync <RepoName> [suffix]}"
SUF="${2:-dev}"
SRC="$HOME/AI/$R"
[ -d "$SRC" ] || { echo "no repo at $SRC"; exit 1; }
TGZ="/tmp/zdev-${R}.tgz"
tar --exclude=target --exclude=.git --exclude='~' \
    --exclude=.zerostack --exclude=.fszero --exclude=.tokenzero --exclude=.asgrep \
    --exclude=.beads --exclude=.rotation --exclude=.ub-exorcism --exclude=.pi-subagents \
    --exclude=codedb.snapshot \
    -czf "$TGZ" -C "$HOME/AI" "$R"
SZ=$(stat -f%z "$TGZ")
[ "$SZ" -lt 4294967296 ] || { echo "tarball ${SZ} bytes exceeds ATP 4GiB cap; add excludes"; exit 1; }
ls -lh "$TGZ"
atp send --transport tcp "$TGZ" spark-1672.local:8473 2>&1 | tail -1
ssh spark "mkdir -p ~/AI/${R}-${SUF} && tar -xzf ~/AI/atp-recv/zdev-${R}.tgz -C ~/AI/${R}-${SUF} --strip-components=1 && ls ~/AI/${R}-${SUF}/crates 2>/dev/null | wc -l && echo EXTRACTED ~/AI/${R}-${SUF}"
