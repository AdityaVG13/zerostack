{
  "schema": "zerostack.release_matrix.v1",
  "bundle_contract": "tests/contracts/release-bundle-v1.schema.json",
  "default_surface": "codemode",
  "startup": {
    "generator": "python3 scripts/install_zerostack.py startup --project-root <project-root> --json",
    "schema": "zerostack.startup_argv.v1",
    "shell": false,
    "argv": ["exec", "-C", "<project-root>"]
  },
  "compatibility": {
    "surface": "mcp",
    "installer_flag": "--compat-mcp",
    "warning_channel": "stderr",
    "warning": "engine MCP compatibility is maintenance-only; CodeMode is the supported default"
  },
  "reproducibility": {
    "source_heads": ["ZeroStack", "FSZero", "GraphZero", "TokenZero"],
    "cargo_locked": true,
    "artifact_hash": "sha256",
    "manifest_signature": "minisign"
  },
  "platforms": [
    {
      "id": "darwin-arm64",
      "rust_target": "aarch64-apple-darwin",
      "archive": "tar.gz",
      "cli": "bin/zsx",
      "node_addon": "bindings/node/prebuilds/darwin-arm64/zsx_node.node"
    },
    {
      "id": "darwin-x86_64",
      "rust_target": "x86_64-apple-darwin",
      "archive": "tar.gz",
      "cli": "bin/zsx",
      "node_addon": "bindings/node/prebuilds/darwin-x64/zsx_node.node"
    },
    {
      "id": "linux-arm64",
      "rust_target": "aarch64-unknown-linux-gnu",
      "archive": "tar.gz",
      "cli": "bin/zsx",
      "node_addon": "bindings/node/prebuilds/linux-arm64-gnu/zsx_node.node"
    },
    {
      "id": "linux-x86_64",
      "rust_target": "x86_64-unknown-linux-gnu",
      "archive": "tar.gz",
      "cli": "bin/zsx",
      "node_addon": "bindings/node/prebuilds/linux-x64-gnu/zsx_node.node"
    },
    {
      "id": "windows-x86_64",
      "rust_target": "x86_64-pc-windows-msvc",
      "archive": "zip",
      "cli": "bin/zsx.exe",
      "node_addon": "bindings/node/prebuilds/win32-x64-msvc/zsx_node.node"
    }
  ]
}
