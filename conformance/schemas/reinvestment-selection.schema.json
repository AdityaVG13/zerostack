{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/reinvestment-selection-v1.schema.json",
  "title": "ZeroStack reinvestment dominance selection record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "claim",
    "claim_digest",
    "evidence_digest",
    "authority_digest"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "claim": {
      "$ref": "#/$defs/selection_claim"
    },
    "claim_digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "selection_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_digest",
        "selected_action_digest",
        "selected_branch_digest",
        "selected_quality_admission_digest",
        "branch_digests",
        "selection_basis",
        "dominance_relation_digest",
        "verifier_identity_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "zerostack.reinvestment.selection"
        },
        "plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "selected_action_digest": {
          "$ref": "#/$defs/digest"
        },
        "branch_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "selection_basis": {
          "enum": [
            "certified_maximum",
            "pairwise_dominant"
          ]
        },
        "dominance_relation_digest": {
          "$ref": "#/$defs/digest"
        },
        "verifier_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "selected_branch_digest": {
          "$ref": "#/$defs/digest"
        },
        "selected_quality_admission_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
