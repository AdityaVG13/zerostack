{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trigger": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision_digest": {
              "$ref": "#/$defs/digest"
            },
            "problem_digest": {
              "$ref": "#/$defs/digest"
            },
            "trigger_kind": {
              "const": "recovery_unknown"
            }
          },
          "required": [
            "trigger_kind",
            "problem_digest",
            "decision_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "quality_admission_digest": {
              "$ref": "#/$defs/digest"
            },
            "trigger_kind": {
              "const": "quality_baseline_selection"
            }
          },
          "required": [
            "trigger_kind",
            "quality_admission_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "failure_code": {
              "enum": [
                "schema_version_mismatch",
                "missing_binding",
                "invalid_source_identity",
                "canonical_digest_mismatch",
                "coherence_failure",
                "invalid_plan",
                "plan_digest_mismatch",
                "reasoning_contract_mismatch",
                "semantic_cut_crossing",
                "attribution_changed",
                "unbounded_worker",
                "bound_exceeded",
                "missing_snap_certificate",
                "missing_safety_shield",
                "irreversible_pre_evidence_effect",
                "performance_unknown",
                "execute_without_permit",
                "forged_permit",
                "plan_step_mismatch",
                "buffer_overflow",
                "early_visible_byte",
                "incomplete_execution",
                "incomplete_trace",
                "forged_predecessor",
                "incomplete_transaction_closure",
                "unaccounted_fallback",
                "missing_approval_grant",
                "forged_receipt"
              ],
              "type": "string"
            },
            "failure_receipt_digest": {
              "$ref": "#/$defs/digest"
            },
            "trigger_kind": {
              "const": "fail_closed"
            }
          },
          "required": [
            "trigger_kind",
            "failure_code",
            "failure_receipt_digest"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://zerostack.dev/schemas/racc-r/exact-deoptimization-plan-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_action_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_closure_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_state_digest": {
      "$ref": "#/$defs/digest"
    },
    "kernel_admission_digest": {
      "$ref": "#/$defs/digest"
    },
    "kernel_binding_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "prior_work_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "safepoint_certificate_digest": {
      "$ref": "#/$defs/digest"
    },
    "schema_version": {
      "const": "zerostack.deoptimization_plan.v1"
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    }
  },
  "required": [
    "schema_version",
    "safepoint_certificate_digest",
    "trigger",
    "candidate_action_digest",
    "candidate_state_digest",
    "candidate_closure_manifest_digest",
    "prior_work_receipt_digest",
    "kernel_binding_digest",
    "kernel_admission_digest",
    "plan_digest"
  ],
  "title": "RACC-R exact deoptimization plan claim V1",
  "type": "object"
}
