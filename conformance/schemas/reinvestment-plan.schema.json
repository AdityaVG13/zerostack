{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/reinvestment-plan-v1.schema.json",
  "title": "ZeroStack causal-slack reinvestment plan record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scope_digest",
    "comparison_identity_digest",
    "raw_baseline_identity_digest",
    "raw_baseline_receipt_digest",
    "assembly_manifest_digest",
    "baseline_state_digest",
    "baseline_reasoning_contract_digest",
    "baseline_budget",
    "declared_additional_budget",
    "strict_candidate_guarded_bound",
    "fallback_reserve",
    "causal_slack",
    "actions",
    "cost_position",
    "plan_digest"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "scope_digest": {
      "$ref": "#/$defs/digest"
    },
    "comparison_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_baseline_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_baseline_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "assembly_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "baseline_state_digest": {
      "$ref": "#/$defs/digest"
    },
    "baseline_reasoning_contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "baseline_budget": {
      "$ref": "#/$defs/resource_vector"
    },
    "declared_additional_budget": {
      "$ref": "#/$defs/resource_vector"
    },
    "strict_candidate_guarded_bound": {
      "$ref": "#/$defs/resource_vector"
    },
    "fallback_reserve": {
      "$ref": "#/$defs/resource_vector"
    },
    "causal_slack": {
      "$ref": "#/$defs/resource_vector"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/action_record"
      },
      "uniqueItems": true
    },
    "cost_position": {
      "enum": [
        "within_raw_baseline",
        "declared_additional_budget"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "counter_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counter_id",
        "unit",
        "boundary_digest",
        "adapter_digest",
        "platform_profile_digest"
      ],
      "properties": {
        "counter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "enum": [
            "tokens",
            "bytes",
            "calls",
            "cpu_nanoseconds",
            "wall_nanoseconds",
            "allocated_bytes",
            "io_bytes"
          ]
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_digest": {
          "$ref": "#/$defs/digest"
        },
        "platform_profile_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "resource_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "amount"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/counter_identity"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "resource_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates"
      ],
      "properties": {
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/resource_amount"
          },
          "uniqueItems": true
        }
      }
    },
    "action_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope_digest",
        "comparison_identity_digest",
        "raw_baseline_identity_digest",
        "assembly_manifest_digest",
        "baseline_state_digest",
        "action_digest",
        "action_kind",
        "candidate_identity_digest",
        "transaction_action_digest",
        "isolation_scope_digest",
        "baseline_reasoning_contract_digest",
        "candidate_reasoning_contract_digest",
        "reasoning_admission_digest",
        "reserved_cost",
        "isolation_verifier_identity_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "zerostack.reinvestment.plan"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "comparison_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "raw_baseline_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "assembly_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "baseline_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "candidate_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "transaction_action_digest": {
          "$ref": "#/$defs/digest"
        },
        "isolation_scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "baseline_reasoning_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "candidate_reasoning_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "reasoning_admission_digest": {
          "$ref": "#/$defs/digest"
        },
        "isolation_verifier_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "action_kind": {
          "enum": [
            "exact_evidence_expansion",
            "same_model_second_candidate",
            "same_model_critique",
            "higher_reasoning_effort",
            "stronger_verifier",
            "counterexample_search",
            "additional_tests",
            "mutation_testing",
            "differential_execution",
            "formal_proof_attempt",
            "larger_fallback_reserve"
          ]
        },
        "reserved_cost": {
          "$ref": "#/$defs/resource_vector"
        }
      }
    },
    "action_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "claim_digest",
        "evidence_digest",
        "authority_digest"
      ],
      "properties": {
        "claim": {
          "$ref": "#/$defs/action_claim"
        },
        "claim_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
