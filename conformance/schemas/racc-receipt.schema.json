{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/racc-receipt.schema.json",
  "title": "RACC Dominance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_identity",
    "target_digest",
    "phases",
    "replay_identity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_identity": {
      "type": "string",
      "minLength": 1
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "charges",
          "reported_total"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "charges": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "successful_trials",
              "failed_trials",
              "retries",
              "verification_calls",
              "recovery_calls",
              "expansions",
              "failed_expansions",
              "fallback_charges"
            ],
            "properties": {
              "successful_trials": {
                "type": "integer",
                "minimum": 0
              },
              "failed_trials": {
                "type": "integer",
                "minimum": 0
              },
              "retries": {
                "type": "integer",
                "minimum": 0
              },
              "verification_calls": {
                "type": "integer",
                "minimum": 0
              },
              "recovery_calls": {
                "type": "integer",
                "minimum": 0
              },
              "expansions": {
                "type": "integer",
                "minimum": 0
              },
              "fallback_charges": {
                "type": "integer",
                "minimum": 0
              },
              "failed_expansions": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "reported_total": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
