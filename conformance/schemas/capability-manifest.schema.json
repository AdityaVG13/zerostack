{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.local/schemas/capability-manifest.schema.json",
  "title": "ZeroStack CodeMode Capability Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "ns", "mutation", "plan_forms", "limits"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "ns": { "enum": ["fz", "tz", "gz"] },
    "mutation": { "enum": ["allowed", "denied", "readonly"] },
    "plan_forms": {
      "type": "array",
      "items": { "enum": ["recipe", "json", "js"] },
      "uniqueItems": true,
      "contains": { "const": "recipe" },
      "minItems": 3
    },
    "limits": { "$ref": "limits.schema.json" }
  }
}
