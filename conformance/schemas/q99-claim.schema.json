{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "u128": {
      "pattern": "^(0|[1-9][0-9]{0,38})$",
      "type": "string"
    },
    "work_profile": {
      "additionalProperties": false,
      "properties": {
        "adapter_digest": {
          "$ref": "#/$defs/digest"
        },
        "counter_id": {
          "minLength": 1,
          "type": "string"
        },
        "platform_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "unit": {
          "enum": [
            "tokens",
            "bytes",
            "calls",
            "cpu_nanoseconds",
            "wall_nanoseconds",
            "allocated_bytes",
            "io_bytes"
          ]
        }
      },
      "required": [
        "counter_id",
        "unit",
        "adapter_digest",
        "platform_profile_digest"
      ],
      "type": "object"
    }
  },
  "$id": "https://zerostack.dev/schemas/racc-r/q99-claim-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attained": {
      "type": "boolean"
    },
    "claim_digest": {
      "$ref": "#/$defs/digest"
    },
    "comparison_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "denominator": {
      "$ref": "#/$defs/u128"
    },
    "label": {
      "enum": [
        "q99-state",
        "q99-input",
        "q99-total"
      ]
    },
    "observed_numerator": {
      "$ref": "#/$defs/u128"
    },
    "schema_version": {
      "const": "zerostack.q99.claim.v1"
    },
    "source_receipt_digests": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "maxItems": 131073,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "task_count": {
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "threshold_denominator": {
      "const": 100
    },
    "threshold_numerator": {
      "maximum": 99,
      "minimum": 1,
      "type": "integer"
    },
    "threshold_relation": {
      "enum": [
        "at_least99_of100",
        "at_most1_of100"
      ]
    },
    "work_profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/work_profile"
        }
      ]
    },
    "workload_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "label",
    "comparison_identity_digest",
    "workload_digest",
    "work_profile",
    "task_count",
    "observed_numerator",
    "denominator",
    "threshold_relation",
    "threshold_numerator",
    "threshold_denominator",
    "attained",
    "source_receipt_digests",
    "claim_digest"
  ],
  "title": "RACC-R receipt-generated labeled Q99 claim V1",
  "type": "object"
}
