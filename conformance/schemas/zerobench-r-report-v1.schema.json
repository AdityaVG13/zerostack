        "complete_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "failed_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "incomplete_runs": {
