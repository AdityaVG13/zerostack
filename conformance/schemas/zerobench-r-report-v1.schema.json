{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/zerobench-r-report-v1.schema.json",
  "title": "ZeroBench-R compiled report record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "registration_digest",
    "arms",
    "strict_verdict",
    "amplify_verdict",
    "all_required_arms_included",
    "best_in_class_claim_authorized",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "zerobench-r-report/v1"
    },
    "contract_version": {
      "const": 1
    },
    "registration_digest": {
      "$ref": "#/$defs/digest"
    },
    "arms": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/arm_report"
      }
    },
    "strict_verdict": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "amplify_verdict": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "all_required_arms_included": {
      "type": "boolean"
    },
    "best_in_class_claim_authorized": {
      "const": false
    },
    "report_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "counter_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counter_id",
        "unit",
        "boundary_digest",
        "adapter_digest",
        "platform_profile_digest"
      ],
      "properties": {
        "counter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "enum": [
            "tokens",
            "bytes",
            "calls",
            "cpu_nanoseconds",
            "wall_nanoseconds",
            "allocated_bytes",
            "io_bytes"
          ]
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_digest": {
          "$ref": "#/$defs/digest"
        },
        "platform_profile_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "aggregate_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "class_totals",
        "observed_total"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/counter_identity"
        },
        "observed_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "class_totals": {
          "$ref": "#/$defs/class_totals"
        }
      }
    },
    "aggregate_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates"
      ],
      "properties": {
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/aggregate_amount"
          }
        }
      }
    },
    "stratum_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum",
        "complete_runs",
        "failed_runs",
        "incomplete_runs",
        "paired_complete_runs",
        "raw_successes",
        "published_successes",
        "rescues_n01",
        "regressions_n10",
        "conservative_hoeffding_lcb_ppm",
        "relative_gain_ppm"
      ],
      "properties": {
        "stratum": {
          "enum": [
            "named_symbol_local_bug",
            "failing_test_diagnosis",
            "stack_trace_localization",
            "cross_file_refactor",
            "dynamic_dispatch_configuration",
            "generated_code_schema_migration",
            "broad_architecture_question",
            "exact_repository_fact",
            "long_build_test_output_diagnosis",
            "ambiguous_task_requiring_evidence",
            "repeated_prepared_task_family",
            "resumed_reasoning_continuation",
            "adversarial_omitted_evidence",
            "transaction_rollback_fault",
