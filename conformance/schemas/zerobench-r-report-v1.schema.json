          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "regressions_n10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "conservative_hoeffding_lcb_ppm": {
          "type": [
            "integer",
            "null"
          ]
        },
        "relative_gain_ppm": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        }
      }
