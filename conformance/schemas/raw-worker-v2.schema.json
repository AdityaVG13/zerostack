{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.local/schemas/raw-worker-v2.schema.json",
  "title": "ZeroStack raw-worker v2 frame",
  "oneOf": [
    { "$ref": "#/$defs/handshake" },
    { "$ref": "#/$defs/call" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/shutdown" },
    { "$ref": "#/$defs/handshakeAck" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/cancelAck" },
    { "$ref": "#/$defs/shutdownAck" }
  ],
  "$defs": {
    "hexDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "cell_id", "request_id", "trace_id", "worker_revision", "contract_digest"],
      "properties": {
        "runtime_id": { "$ref": "#/$defs/nonEmpty" },
        "cell_id": { "$ref": "#/$defs/nonEmpty" },
        "request_id": { "$ref": "#/$defs/nonEmpty" },
        "trace_id": { "$ref": "#/$defs/nonEmpty" },
        "parent_span_id": { "$ref": "#/$defs/nonEmpty" },
        "worker_revision": { "$ref": "#/$defs/nonEmpty" },
        "contract_digest": { "$ref": "#/$defs/hexDigest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "root", "session_id", "worker_revision", "semantic_contract_version", "semantic_contract_digest", "operation_registry_digest", "ref_scheme"],
      "properties": {
        "engine": { "$ref": "#/$defs/nonEmpty" },
        "root": { "$ref": "#/$defs/nonEmpty" },
        "session_id": { "$ref": "#/$defs/nonEmpty" },
        "worker_revision": { "$ref": "#/$defs/nonEmpty" },
        "semantic_contract_version": { "$ref": "#/$defs/nonEmpty" },
        "semantic_contract_digest": { "$ref": "#/$defs/hexDigest" },
        "operation_registry_digest": { "$ref": "#/$defs/hexDigest" },
        "ref_scheme": { "enum": ["fz", "gz", "tz"] }
      }
    },
    "handshakeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "root", "session_id", "expected_engine", "expected_contract_digest"],
      "properties": {
        "protocol_version": { "const": "zerostack.raw_worker.v2" },
        "root": { "$ref": "#/$defs/nonEmpty" },
        "session_id": { "$ref": "#/$defs/nonEmpty" },
        "expected_engine": { "$ref": "#/$defs/nonEmpty" },
        "expected_worker_revision": { "$ref": "#/$defs/nonEmpty" },
        "expected_contract_digest": { "$ref": "#/$defs/hexDigest" },
        "expected_registry_digest": { "$ref": "#/$defs/hexDigest" }
      }
    },
    "callRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "op", "args", "trace"],
      "properties": {
        "request_id": { "$ref": "#/$defs/nonEmpty" },
        "op": { "$ref": "#/$defs/nonEmpty" },
        "args": {},
        "deadline_unix_ms": { "type": "integer", "minimum": 1 },
        "trace": { "$ref": "#/$defs/trace" }
      }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "handshake" },
        "request": { "$ref": "#/$defs/handshakeRequest" }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "call" },
        "request": { "$ref": "#/$defs/callRequest" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "cancel" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id"],
          "properties": {
            "request_id": { "$ref": "#/$defs/nonEmpty" },
            "reason": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "shutdown" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "$ref": "#/$defs/nonEmpty" } }
        }
      }
    },
    "handshakeAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ack"],
      "properties": {
        "kind": { "const": "handshake_ack" },
        "ack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "binding", "capabilities", "limits", "protocol_digest"],
          "properties": {
            "protocol_version": { "const": "zerostack.raw_worker.v2" },
            "binding": { "$ref": "#/$defs/binding" },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cancellation", "deadlines", "approvals", "revert", "snapshots"],
              "properties": {
                "cancellation": { "type": "boolean" },
                "deadlines": { "type": "boolean" },
                "approvals": { "type": "boolean" },
                "revert": { "type": "boolean" },
                "snapshots": { "type": "boolean" }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_frame_bytes", "max_output_bytes", "max_in_flight", "default_deadline_ms"],
              "properties": {
                "max_frame_bytes": { "type": "integer", "minimum": 1 },
                "max_output_bytes": { "type": "integer", "minimum": 1 },
                "max_in_flight": { "type": "integer", "minimum": 1 },
                "default_deadline_ms": { "type": "integer", "minimum": 1 }
              }
            },
            "protocol_digest": { "$ref": "#/$defs/hexDigest" }
          }
        }
      }
    },
    "resultMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "approval", "revert", "ownership", "trace"],
      "properties": {
        "effect": { "enum": ["read_only", "reversible_mutation", "approval_required_mutation", "irreversible"] },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["not_required", "required", "granted", "denied"] },
            "approval_id": { "$ref": "#/$defs/nonEmpty" },
            "policy": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "revert": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported"],
          "properties": {
            "supported": { "type": "boolean" },
            "journal_id": { "$ref": "#/$defs/nonEmpty" },
            "rollback_op": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "session_id", "refs"],
          "properties": {
            "engine": { "$ref": "#/$defs/nonEmpty" },
            "session_id": { "$ref": "#/$defs/nonEmpty" },
            "refs": { "type": "array", "items": { "type": "string" } },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "$ref": "#/$defs/nonEmpty" },
                "id": { "$ref": "#/$defs/nonEmpty" },
                "digest": { "$ref": "#/$defs/hexDigest" }
              }
            }
          }
        },
        "trace": { "$ref": "#/$defs/trace" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request_id", "result"],
      "properties": {
        "kind": { "const": "result" },
        "request_id": { "$ref": "#/$defs/nonEmpty" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "metadata"],
          "properties": {
            "value": {},
            "metadata": { "$ref": "#/$defs/resultMetadata" }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "error"],
      "properties": {
        "kind": { "const": "error" },
        "request_id": { "$ref": "#/$defs/nonEmpty" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message", "retryable"],
          "properties": {
            "kind": { "$ref": "#/$defs/nonEmpty" },
            "message": { "$ref": "#/$defs/nonEmpty" },
            "retryable": { "type": "boolean" },
            "details": {}
          }
        },
        "trace": { "$ref": "#/$defs/trace" }
      }
    },
    "cancelAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request_id", "cancelled"],
      "properties": {
        "kind": { "const": "cancel_ack" },
        "request_id": { "$ref": "#/$defs/nonEmpty" },
        "cancelled": { "type": "boolean" }
      }
    },
    "shutdownAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "shutdown_ack" } }
    }
  }
}
