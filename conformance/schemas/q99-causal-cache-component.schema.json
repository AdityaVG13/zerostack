{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_owner": {
          "enum": [
            "zero_stack",
            "fs_zero",
            "graph_zero",
            "token_zero",
            "pi_zero_stack"
          ],
          "type": "string"
        },
        "dependency_root": {
          "$ref": "#/$defs/digest"
        },
        "invalidation_certificate_digest": {
          "$ref": "#/$defs/digest"
        },
        "producer_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "protected_use_class_digest": {
          "$ref": "#/$defs/digest"
        },
        "reasoning_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "recovery_route_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_root": {
          "$ref": "#/$defs/digest"
        },
        "verifier_scope_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "artifact_digest",
        "source_root",
        "dependency_root",
        "producer_contract_digest",
        "protected_use_class_digest",
        "reasoning_contract_digest",
        "verifier_scope_digest",
        "invalidation_certificate_digest",
        "recovery_route_digest",
        "artifact_owner"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "exact"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "sound_overapproximation"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "byte_identical_prefix"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "provider_eligible"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "minimum": 1,
              "type": "integer"
            },
            "validity": {
              "const": "provider_reported_hit"
            }
          },
          "required": [
            "validity",
            "tokens"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "exact_reasoning_continuation"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error_bound_digest": {
              "$ref": "#/$defs/digest"
            },
            "validity": {
              "const": "approximate"
            }
          },
          "required": [
            "validity",
            "error_bound_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "const": "unknown"
            }
          },
          "required": [
            "validity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason_digest": {
              "$ref": "#/$defs/digest"
            },
            "validity": {
              "const": "invalid"
            }
          },
          "required": [
            "validity",
            "reason_digest"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://zerostack.dev/schemas/racc-r/q99-causal-cache-component-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "component_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "coordinate": {
      "enum": [
        "source",
        "producer",
        "graph",
        "tokenization",
        "rendering",
        "provider_cache",
        "reasoning_continuation",
        "verifier",
        "quality"
      ]
    },
    "owner": {
      "enum": [
        "zero_stack",
        "fs_zero",
        "graph_zero",
        "token_zero",
        "pi_zero_stack"
      ]
    },
    "schema_version": {
      "const": "zerostack.q99.causal_cache_component"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "verifier_identity_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "binding",
    "coordinate",
    "owner",
    "validity",
    "component_receipt_digest",
    "verifier_identity_digest"
  ],
  "title": "RACC-R Q99 causal cache component claim V1",
  "type": "object"
}
