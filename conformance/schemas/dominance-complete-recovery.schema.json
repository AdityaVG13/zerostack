{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://zerostack.dev/schemas/racc-r/dcr-certificate-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessible_effect_surface_digest": {
      "$ref": "#/$defs/digest"
    },
    "baseline_identity": {
      "$ref": "#/$defs/digest"
    },
    "common_baseline_dominant_effect_class": {
      "$ref": "#/$defs/digest"
    },
    "conflict_hyperedges": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "coverage_certificate": {
      "$ref": "#/$defs/digest"
    },
    "decision_view_digest": {
      "$ref": "#/$defs/digest"
    },
    "fallback_safepoint": {
      "$ref": "#/$defs/digest"
    },
    "fiber_status": {
      "enum": [
        "exact",
        "sound-overapproximation",
        "unknown",
        "conflict"
      ]
    },
    "project_root": {
      "$ref": "#/$defs/digest"
    },
    "reasoning_contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "recovery_query_trace": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "racc-r-dcr-certificate"
    },
    "task_identity": {
      "$ref": "#/$defs/digest"
    },
    "verifier_route": {
      "$ref": "#/$defs/digest"
    },
    "world_fiber_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "project_root",
    "task_identity",
    "world_fiber_digest",
    "fiber_status",
    "baseline_identity",
    "reasoning_contract_digest",
    "decision_view_digest",
    "accessible_effect_surface_digest",
    "common_baseline_dominant_effect_class",
    "coverage_certificate",
    "conflict_hyperedges",
    "verifier_route",
    "fallback_safepoint"
  ],
  "title": "RACC-R DominanceCompleteRecoveryCertificate V1",
  "type": "object"
}
