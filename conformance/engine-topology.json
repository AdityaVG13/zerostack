        "worker_binary": "tokenzero-codemode",
        "cli_binary": "tokenzero",
        "build_commands": [
          {
            "id": "workspace-check",
            "runner": "rch",
            "program": "cargo",
            "args": [
              "check",
              "--locked",
              "--workspace",
              "--all-targets"
            ],
            "working_directory": "tokenzero",
            "purpose": "Validate the canonical workspace",
            "env": {
              "CARGO_TARGET_DIR": ".rch-target/tokenzero"
