{
  "$schema": "https://zerostack.local/schemas/engine-topology.schema.json",
  "schema_version": "1",
  "topology_id": "zerostack.engine-topology",
  "status": "accepted-for-migration",
  "source_repositories": [
    {
      "id": "zerostack",
      "name": "ZeroStack",
      "cargo_manifest": "Cargo.toml",
      "branch": "main",
      "role": "contract-hub"
    },
    {
      "id": "tokenzero",
      "name": "TokenZero",
      "cargo_manifest": "Cargo.toml",
      "branch": "main",
      "role": "domain-engine"
    },
    {
      "id": "fszero",
      "name": "FSZero",
      "cargo_manifest": "Cargo.toml",
      "branch": "main",
      "role": "domain-engine"
    },
    {
      "id": "graphzero",
      "name": "GraphZero",
      "cargo_manifest": "Cargo.toml",
      "branch": "main",
      "role": "domain-engine"
    }
  ],
  "hub": {
    "repository": "zerostack",
    "workspace_manifest": "Cargo.toml",
    "crates": [
      {
        "name": "zero-abi",
        "path": "crates/zero-abi",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-cert",
        "path": "crates/zero-cert",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-codemode",
        "path": "crates/zero-codemode",
        "role": "restricted-interpreter-and-legacy-conformance",
        "status": "keep"
      },
      {
        "name": "zero-gate",
        "path": "crates/zero-gate",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-gauge",
        "path": "crates/zero-gauge",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-ledger",
        "path": "crates/zero-ledger",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-ref",
        "path": "crates/zero-ref",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-store",
        "path": "crates/zero-store",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-testkit",
        "path": "tests/zero-testkit",
        "role": "test-support",
        "status": "keep"
      },
      {
        "name": "zero-machine-permit",
        "path": "crates/zerostack-machine-permit",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-process",
        "path": "crates/zero-process",
        "role": "hub-foundation",
        "status": "keep"
      },
      {
        "name": "zero-mcp",
        "path": "crates/zero-mcp",
        "role": "canonical-mcp-carrier",
        "status": "keep"
      },
      {
        "name": "zsx-core",
        "path": "crates/zsx-core",
        "role": "canonical-native-composition",
        "status": "keep"
      },
      {
        "name": "zsx-node",
        "path": "crates/zsx-node",
        "role": "native-node-binding",
        "status": "keep"
      },
      {
        "name": "zsx",
        "path": "crates/zsx",
        "role": "universal-native-cli",
        "status": "keep"
      }
    ],
    "binaries": [
      {
        "name": "zsx",
        "package": "zsx",
        "path": "crates/zsx/src/main.rs",
        "role": "single-process-runtime",
        "status": "keep"
      },
      {
        "name": "zerostack-codemode-conformance",
        "package": "zerostack-codemode-conformance",
        "path": "conformance/src/main.rs",
        "role": "public-interface-conformance",
        "status": "keep"
      },
      {
        "name": "raw_worker",
        "package": "zerostack-fuzz",
        "path": "archive/pruned-20260730/fuzz/fuzz_targets/raw_worker.rs",
        "role": "historical-fuzzer",
        "status": "quarantine"
      }
    ],
    "build_commands": [
      {
        "id": "hub-workspace-check",
        "runner": "rch",
        "program": "cargo",
        "args": [
          "check",
          "--locked",
          "--workspace",
          "--all-targets"
        ],
        "working_directory": "zerostack",
        "purpose": "Validate hub through isolated RCH",
        "env": {
          "CARGO_TARGET_DIR": ".rch-target/zerostack"
        }
      },
      {
        "id": "hub-zsx-release",
        "runner": "rch",
        "program": "cargo",
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "zsx",
          "--bin",
          "zsx"
        ],
        "working_directory": "zerostack",
        "purpose": "Build the canonical single-process ZSX executable",
        "env": {
          "CARGO_TARGET_DIR": ".rch-target/zerostack"
        }
      }
    ]
  },
  "canonical_engine_skeleton": {
    "roles": [
      {
        "id": "domain-core",
        "required": true,
        "package_pattern": "<engine>-core or existing domain crates",
        "binary_pattern": null,
        "owner": "engine"
      },
      {
        "id": "raw-worker",
        "required": true,
        "package_pattern": "<engine>-worker",
        "binary_pattern": "<engine>-codemode",
        "owner": "engine"
      },
      {
        "id": "cli",
        "required": true,
        "package_pattern": "<engine>-cli",
        "binary_pattern": "<engine>",
        "owner": "engine"
      },
      {
        "id": "test-support",
        "required": true,
        "package_pattern": "<engine>-test-support",
        "binary_pattern": null,
        "owner": "engine"
      },
      {
        "id": "optional-developer-tool",
        "required": false,
        "package_pattern": "<engine>-xtask or verification package",
        "binary_pattern": "tool-specific",
        "owner": "engine"
      }
    ],
    "feature_policy": {
      "worker_default_features": [],
      "worker_forbidden_features": [
        "quickjs",
        "js",
        "surface-mcp",
        "mcp-catalog",
        "planner",
        "nested-codemode",
        "harness-routing"
      ],
      "host_feature_owner": "zero-codemode",
      "adapter_feature_owner": "hub-adapter-package"
    },
    "quality_gate_policy": {
      "repositories": [
        "zerostack",
        "tokenzero",
        "fszero",
        "graphzero"
      ],
      "runner": "rch",
      "rustfmt_args": [
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "clippy_args_template": [
        "clippy",
        "-p",
        "<package>",
        "--all-targets",
        "--no-deps",
        "--",
        "-D",
        "warnings"
      ],
      "activation": "required-before-canonical-migration",
      "existing_debt_policy": "does-not-weaken-migration-gate"
    },
    "binary_policy": {
      "cli_suffix": "",
      "worker_suffix": "-codemode",
      "shipping_binaries": [
        "<engine>",
        "<engine>-codemode"
      ]
    },
    "host_client_contract": {
      "name": "zsx-native-session-v1",
      "entrypoint": "@zerostack/zsx-native",
      "stability": "public-versioned",
      "reference_bridge": "hub-owned"
    }
  },
  "dependency_direction": {
    "layers": [
      {
        "id": "hub-foundation",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      },
      {
        "id": "hub-host",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      },
      {
        "id": "engine-domain",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      },
      {
        "id": "engine-worker",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      },
      {
        "id": "harness-adapter",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      },
      {
        "id": "conformance",
        "may_depend_on": [
          "declared-lower-layer"
        ],
        "must_not_depend_on": [
          "private-upper-layer"
        ]
      }
    ],
    "allowed_edges": [
      {
        "from": "hub-host",
        "to": "hub-foundation"
      },
      {
        "from": "hub-host",
        "to": "hub-worker-adapter"
      },
      {
        "from": "engine-domain",
        "to": "hub-contract"
      },
      {
        "from": "engine-domain",
        "to": "hub-accounting"
      },
      {
        "from": "engine-worker",
        "to": "engine-domain"
      },
      {
        "from": "engine-worker",
        "to": "hub-worker-adapter"
      },
      {
        "from": "harness-adapter",
        "to": "hub-host-client"
      },
      {
        "from": "conformance",
        "to": "engine-worker-public-interface"
      }
    ],
    "forbidden_edges": [
      {
        "from": "engine-worker",
        "to": "planner"
      },
      {
        "from": "engine-worker",
        "to": "QuickJS"
      },
      {
        "from": "engine-worker",
        "to": "MCP-catalog"
      },
      {
        "from": "engine-worker",
        "to": "nested-CodeMode"
      },
      {
        "from": "engine-domain",
        "to": "harness-adapter"
      },
      {
        "from": "harness-adapter",
        "to": "engine-private"
      },
      {
        "from": "engine-domain",
        "to": "other-engine-private"
      },
      {
        "from": "conformance",
        "to": "engine-private-files"
      }
    ]
  },
  "raw_worker": {
    "protocol": "raw-worker-v2",
    "required_capabilities": [
      "engine-identity",
      "contract-digest",
      "bounded-io",
      "deadline",
      "cancellation",
      "typed-errors",
      "durable-refs"
    ],
    "required_fields": [
      "protocol_version",
      "engine_identity",
      "contract_digest",
      "request_id",
      "operation",
      "deadline",
      "cancellation",
      "store_root",
      "response_or_typed_error"
    ],
    "prohibitions": [
      "planner",
      "QuickJS-runtime",
      "MCP-catalog",
      "harness-discovery",
      "nested-CodeMode",
      "Pi-routing",
      "unbounded-child-process",
      "hidden-async-tail",
      "journal-bypass",
      "cancellation-bypass",
      "RACC-bypass",
      "typed-failure-bypass",
      "private-protocol"
    ],
    "runtime_owner": "zero-codemode-legacy-conformance",
    "unknown_fields": "versioned",
    "skew_policy": "fail-closed"
  },
  "harness_adapters": [
    {
      "id": "plain-cli",
      "kind": "plain-cli",
      "entrypoint": "zsx",
      "transport": "in-process-cli",
      "owns": [
        "argument-parsing",
        "terminal-rendering",
        "exit-code-mapping"
      ],
      "depends_on": [
        "hub-host-client",
        "hub-artifact-manifest",
        "hub-reference-bridge"
      ],
      "must_not_import": [
        "engine-private-runtime",
        "Pi-internals",
        "copied-worker-protocol"
      ],
      "status": "thin-adapter"
    },
    {
      "id": "mcp-claude-code",
      "kind": "mcp-claude-code",
      "entrypoint": "zero-mcp",
      "transport": "MCP-negotiated-stdio-or-http",
      "owns": [
        "MCP-transport",
        "tool-presentation",
        "capability-negotiation"
      ],
      "depends_on": [
        "hub-host-client",
        "hub-artifact-manifest",
        "hub-reference-bridge"
      ],
      "must_not_import": [
        "engine-private-runtime",
        "Pi-internals",
        "copied-worker-protocol"
      ],
      "status": "thin-adapter"
    },
    {
      "id": "pi",
      "kind": "pi",
      "entrypoint": "@zerostack/zsx-native",
      "transport": "Pi-native-N-API",
      "owns": [
        "Pi-tool-presentation",
        "Pi-routing",
        "optional-lane-integration"
      ],
      "depends_on": [
        "hub-host-client",
        "hub-artifact-manifest",
        "hub-reference-bridge"
      ],
      "must_not_import": [
        "engine-private-runtime",
        "Pi-internals",
        "copied-worker-protocol"
      ],
      "status": "thin-adapter"
    },
    {
      "id": "third-party",
      "kind": "third-party",
      "entrypoint": "zsx",
      "transport": "in-process-cli",
      "owns": [
        "configuration",
        "host-lifecycle",
        "public-contract-conformance"
      ],
      "depends_on": [
        "hub-host-client",
        "hub-artifact-manifest",
        "hub-reference-bridge"
      ],
      "must_not_import": [
        "engine-private-runtime",
        "Pi-internals",
        "copied-worker-protocol"
      ],
      "status": "thin-adapter"
    },
    {
      "id": "omp",
      "kind": "omp",
      "entrypoint": "@zerostack/zsx-native",
      "transport": "OMP-native-N-API",
      "owns": [
        "OMP-tool-presentation",
        "AbortSignal-forwarding",
        "session-shutdown"
      ],
      "depends_on": [
        "zsx-native-session-v1",
        "hub-reference-bridge"
      ],
      "must_not_import": [
        "engine-private-runtime",
        "Pi-internals",
        "process-lifecycle"
      ],
      "status": "thin-adapter"
    }
  ],
  "engines": [
