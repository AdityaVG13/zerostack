          {
            "id": "cli-release",
            "runner": "rch",
            "program": "cargo",
            "args": [
              "build",
              "--locked",
              "--release",
              "-p",
              "tokenzero-cli",
              "--bin",
              "tokenzero"
            ],
            "working_directory": "tokenzero",
            "purpose": "Build the canonical CLI",
            "env": {
              "CARGO_TARGET_DIR": ".rch-target/tokenzero"
            }
          },
          {
            "id": "worker-release",
            "runner": "rch",
            "program": "cargo",
            "args": [
              "build",
              "--locked",
              "--release",
              "-p",
              "tokenzero-worker",
              "--bin",
              "tokenzero-codemode",
              "--no-default-features"
            ],
            "working_directory": "tokenzero",
            "purpose": "Build the planner-free raw worker",
