    {
      "id": "fszero",
      "name": "FSZero",
      "repository": "FSZero",
      "domain": "filesystem indexing, search, read, mutation, snapshots",
      "target": {
        "domain_packages": [
          "fszero-domain"
        ],
        "worker_package": "fszero-worker",
        "cli_package": "fszero-cli",
        "test_support_package": "fszero-test-support",
        "optional_packages": [
          "fszero-xtask"
        ],
        "worker_binary": "fszero-codemode",
        "cli_binary": "fszero",
        "build_commands": [
          {
            "id": "workspace-check",
            "runner": "rch",
            "program": "cargo",
            "args": [
              "check",
              "--locked",
              "--workspace",
              "--all-targets"
