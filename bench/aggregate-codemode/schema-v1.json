{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/aggregate-codemode-benchmark-v1.json",
  "title": "ZeroStack aggregate CodeMode benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "bead_key",
    "captured_at",
    "benchmark_semantics",
    "config",
    "corpus",
    "provenance",
    "trials",
    "summaries",
    "comparisons",
    "rerun_tolerance",
    "differential_correctness",
    "accepted_optimizations",
    "result",
    "residual_assumptions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "zerostack.aggregate_codemode_benchmark.v1" },
    "bead_key": { "const": "zerostack-codemode-first-execution-jgm.6" },
    "captured_at": { "type": "string", "format": "date-time" },
    "benchmark_semantics": { "type": "object" },
    "config": {
      "type": "object",
      "required": ["coldRuns", "warmRuns", "repetitions", "warmup", "toleranceRelative", "toleranceAbsoluteNs"]
    },
    "corpus": {
      "type": "object",
      "required": ["workloads", "modes", "sha256", "definition"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_repositories", "addon", "machine", "runtime_status_digests"]
    },
    "trials": {
      "type": "array",
      "minItems": 36,
      "items": {
        "type": "object",
        "required": [
          "sequence", "repetition", "phase", "index", "workload", "mode",
          "wall_ns", "process_cpu_user_us", "process_cpu_system_us",
          "rss_before_bytes", "rss_after_bytes", "input_bytes", "output_bytes",
          "model_visible_turns", "token_accounting", "envelope_digest",
          "envelope_statuses", "result_digest",
          "canonical_result", "expected_result", "differential_correct",
          "fixture_identity_sha256", "fixture_content_sha256"
        ]
      }
    },
    "summaries": { "type": "array", "minItems": 36 },
    "comparisons": { "type": "array", "minItems": 12 },
    "rerun_tolerance": {
      "type": "object",
      "required": ["declared", "checks", "passed"]
    },
    "differential_correctness": {
      "type": "object",
      "required": ["expected_by_workload", "failures", "passed"]
    },
    "accepted_optimizations": { "type": "array", "maxItems": 0 },
    "result": { "enum": ["passed", "failed"] },
    "residual_assumptions": { "type": "array", "minItems": 1 }
  }
}
