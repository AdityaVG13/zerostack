{
  "$id": "https://fszero.dev/schemas/bench-history-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "type": "string"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "harness_evidence": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "policy": {
      "additionalProperties": true,
      "properties": {
        "no_pass_over_pass": {
          "const": true
        },
        "threshold_change_requires_decision": {
          "const": true
        }
      },
      "required": [
        "no_pass_over_pass",
        "threshold_change_requires_decision"
      ],
      "type": "object"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "runner": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "measurement_scope": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "runner_class": {
          "type": "string"
        }
      },
      "required": [
        "runner_class",
        "os",
        "arch",
        "profile",
        "measurement_scope"
      ],
      "type": "object"
    },
    "schema": {
      "const": "fszero.bench-history"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "git_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "harness_schema": {
          "type": "string"
        },
        "probe_restore_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "git_commit",
        "git_dirty",
        "command",
        "harness_schema"
      ],
      "type": "object"
    },
    "statistical_profile": {
      "additionalProperties": false,
      "properties": {
        "measured_trials_per_surface": {
          "minimum": 1,
          "type": "integer"
        },
        "minimum_measured_trials": {
          "const": 20
        },
        "ordered_raw_trials": {
          "type": "boolean"
        },
        "outlier_policy": {
          "type": "string"
        },
        "percentile_method": {
          "type": "string"
        },
        "sample_size_exception": {
          "additionalProperties": false,
          "properties": {
            "conservative_tail": {
              "const": true
            },
            "reason": {
              "type": "string"
            },
            "removal_condition": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "removal_condition",
            "conservative_tail"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "total_trials_per_surface": {
          "minimum": 1,
          "type": "integer"
        },
        "warmup_trials_discarded": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_trials_per_surface",
        "warmup_trials_discarded",
        "measured_trials_per_surface",
        "minimum_measured_trials",
        "percentile_method",
        "outlier_policy",
        "ordered_raw_trials"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "pass",
        "tracked_fail",
        "blocked"
      ]
    }
  },
  "required": [
    "schema",
    "benchmark_id",
    "status",
    "recorded_at",
    "source",
    "runner",
    "statistical_profile",
    "policy",
    "metrics",
    "failures",
    "harness_evidence"
  ],
  "title": "FSZero benchmark history record v1",
  "type": "object"
}
