# FSZero public tree -- deny-by-default at repo root.
# New docs / dumps / research trees stay local unless the operator approves.

/*
!/crates/
!/tests/
!/docs/
!/.github/
!/benchmarks/
!/scripts/
!/packaging/
!/contracts/
!/xtask/
!/.bench-history/
!/.cargo/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/deny.toml
!/LICENSE
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/.gitignore
!/.gitattributes

# Inside public folders
/tests/artifacts/
/tests/ship-mutation-receipts.json
/tests/ship-mutations.json
*.proptest-regressions
.cargo/*
!.cargo/
!.cargo/config.toml

# Anywhere
/target/
.env
.env.*
!.env.example
.fszero/
.tokenzero/
.zerostack/
.graphzero/
.asgrep/
.beads/
.bv/
.cursor/
.grok/
.claude/
AGENTS.md
Agents.md
CLAUDE.md
Claude.md
.papercuts.jsonl
.DS_Store
__pycache__/
*.log
*.snapshot
results/
**/.asgrep/
**/.tokenzero/
**/.fszero/
