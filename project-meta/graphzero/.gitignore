# GraphZero public tree -- deny-by-default at repo root.
# New docs / dumps / research trees stay local unless the operator approves.

/*
!/crates/
!/tests/
!/docs/
!/.github/
!/benchmarks/
!/scripts/
!/fuzz/
!/packaging/
!/.cargo/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/deny.toml
!/Makefile
!/LICENSE
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/pyproject.toml
!/uv.lock
!/.python-version
!/.gitignore
!/.gitattributes

# Inside public folders
/tests/artifacts/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/target/
/benchmarks/results/
/benchmarks/gold/search/corpus/
.cargo/*
!.cargo/
!.cargo/config.toml

# Anywhere
/target/
.env
.env.*
.zerostack/
.fszero/
.graphzero/
.tokenzero/
.asgrep/
.beads/
.bv/
.cursor/
.grok/
.claude/
AGENTS.md
Agents.md
CLAUDE.md
Claude.md
.papercuts.jsonl
.DS_Store
__pycache__/
*.log
*.snapshot
results/
**/.asgrep/
