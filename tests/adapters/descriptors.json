{
  "version": "zerostack.shared-suite.adapters.v1",
  "adapters": [
    {
      "id": "fszero",
      "engine": "FSZero",
      "transport": "raw-worker-v2",
      "namespace": "fz",
      "surface": "codemode",
      "binary_env": "FSZERO_CODEMODE_BIN",
      "command": "explicit-binary",
      "probe": "capabilities --json",
      "serve": "--raw-worker --root <root>"
    },
    {
      "id": "graphzero",
      "engine": "GraphZero",
      "transport": "raw-worker-v2",
      "namespace": "gz",
      "surface": "codemode",
      "binary_env": "GRAPHZERO_CODEMODE_BIN",
      "command": "explicit-binary",
      "probe": "capabilities --json",
      "serve": "default serve mode (GRAPHZERO_REPO env)"
    },
    {
      "id": "tokenzero",
      "engine": "TokenZero",
      "transport": "raw-worker-v2",
      "namespace": "tz",
      "surface": "codemode",
      "binary_env": "TOKENZERO_CODEMODE_BIN",
      "command": "explicit-binary",
      "probe": "capabilities --json",
      "serve": "raw-worker --root <root>"
    },
    {
      "id": "reference",
      "engine": "reference",
      "transport": "reference-python",
      "namespace": "reference",
      "surface": "reference",
      "command": "scripts/reference_adapter.py"
    },
    {
      "id": "cli",
      "engine": "CLI",
      "transport": "process",
      "namespace": "reference",
      "surface": "codemode",
      "binary_env": "ZEROSTACK_CONFORMANCE_BIN",
      "command": "ZEROSTACK_CONFORMANCE_BIN"
    }
  ]
}
