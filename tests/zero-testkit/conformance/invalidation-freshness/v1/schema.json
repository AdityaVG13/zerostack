{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/invalidation-freshness-v1.schema.json",
  "title": "ZeroStack invalidation and freshness result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_version",
    "certificate",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_version": {
      "const": "zerostack.invalidation-freshness.v1"
    },
    "certificate": {
      "$ref": "#/$defs/indexedThrough"
    },
    "result": {
      "$ref": "#/$defs/decision"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9./:_-]+$"
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/identity"
        },
        "head": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "consumer",
        "kind"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/identity"
        },
        "consumer": {
          "$ref": "#/$defs/identity"
        },
        "kind": {
          "enum": [
            "reads",
            "derives",
            "invalidates"
          ]
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "essential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "dependency",
        "witness",
        "certificate_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "dependency": {
          "$ref": "#/$defs/edge"
        },
        "witness": {
          "$ref": "#/$defs/witness"
        },
        "certificate_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "model_version",
        "assembly_manifest_digest",
        "source_repository_heads",
        "producer_domains",
        "influence_scope",
        "edges",
        "essential_dependencies",
        "certificate_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "model_version": {
          "const": "zerostack.invalidation-freshness.v1"
        },
        "assembly_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_repository_heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/head"
          }
        },
        "producer_domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "filesystem_index",
              "graph_index",
              "token_cache"
            ]
          }
        },
        "influence_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "essential_dependencies": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/essential"
          }
        },
        "certificate_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "indexedThrough": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "model_version",
        "index_id",
        "index_generation",
        "influence",
        "replay_identity",
        "certificate_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "model_version": {
          "const": "zerostack.invalidation-freshness.v1"
        },
        "index_id": {
          "$ref": "#/$defs/identity"
        },
        "index_generation": {
          "type": "integer",
          "minimum": 0
        },
        "influence": {
          "$ref": "#/$defs/closure"
        },
        "replay_identity": {
          "$ref": "#/$defs/digest"
        },
        "certificate_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "failureCode": {
      "enum": [
        "UNSUPPORTED_SCHEMA_VERSION",
        "MODEL_VERSION_MISMATCH",
        "INVALID_IDENTITY",
        "DUPLICATE_IDENTITY",
        "NON_CANONICAL_ORDER",
        "CONTRACT_LIMIT_EXCEEDED",
        "ASSEMBLY_MISMATCH",
        "SOURCE_HEAD_MISMATCH",
        "MISSING_PROOF_SCOPE",
        "MISSING_EDGE",
        "SCOPE_INFLATION",
        "INCOMPARABLE_SCOPE",
        "GENERATION_ROLLBACK",
        "REPLAY_IDENTITY_MISMATCH",
        "CERTIFICATE_DIGEST_MISMATCH",
        "SERIALIZATION_FAILURE"
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "status",
            "trusted",
            "failure_code",
            "detail",
            "indexed_certificate_digest"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "status": {
              "const": "fresh"
            },
            "trusted": {
              "const": true
            },
            "failure_code": {
              "type": "null"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "indexed_certificate_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "status",
            "trusted",
            "failure_code",
            "detail",
            "indexed_certificate_digest"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "status": {
              "enum": [
                "index_behind",
                "unknown"
              ]
            },
            "trusted": {
              "const": false
            },
            "failure_code": {
              "$ref": "#/$defs/failureCode"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "indexed_certificate_digest": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
