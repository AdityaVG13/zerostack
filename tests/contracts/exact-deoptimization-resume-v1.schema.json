{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "racc_work": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "fallback_work": {
          "minimum": 0,
          "type": "integer"
        },
        "latency_micros": {
          "minimum": 0,
          "type": "integer"
        },
        "logical_input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "peak_memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "reasoning_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "uncached_input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "verifier_work": {
          "minimum": 0,
          "type": "integer"
        },
        "visible_output_tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "logical_input_tokens",
        "uncached_input_tokens",
        "cached_input_tokens",
        "reasoning_tokens",
        "visible_output_tokens",
        "tool_calls",
        "verifier_work",
        "fallback_work",
        "latency_micros",
        "peak_memory_bytes"
      ],
      "type": "object"
    },
    "route_usage": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "fuel": {
          "minimum": 0,
          "type": "integer"
        },
        "io_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "processes": {
          "minimum": 0,
          "type": "integer"
        },
        "risk_units": {
          "minimum": 0,
          "type": "integer"
        },
        "work": {
          "$ref": "#/$defs/racc_work"
        },
        "worker_steps": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fuel",
        "elapsed_ms",
        "io_bytes",
        "output_bytes",
        "memory_bytes",
        "processes",
        "risk_units",
        "worker_steps",
        "work"
      ],
      "type": "object"
    }
  },
  "$id": "https://zerostack.dev/schemas/racc-r/exact-deoptimization-resume-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_overlay_disposition_digest": {
      "$ref": "#/$defs/digest"
    },
    "deoptimization_usage": {
      "$ref": "#/$defs/route_usage"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "prior_receipt_head_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_baseline_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_baseline_input_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_decision_view_digest": {
      "$ref": "#/$defs/digest"
    },
    "restoration_verifier_identity_digest": {
      "$ref": "#/$defs/digest"
    },
    "restored_external_inventory_digest": {
      "$ref": "#/$defs/digest"
    },
    "restored_fixed_model_digest": {
      "$ref": "#/$defs/digest"
    },
    "restored_project_root": {
      "$ref": "#/$defs/digest"
    },
    "restored_reasoning_contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "restored_reasoning_entry_digest": {
      "$ref": "#/$defs/digest"
    },
    "safepoint_certificate_digest": {
      "$ref": "#/$defs/digest"
    },
    "schema_version": {
      "const": "zerostack.baseline_restoration.v1"
    },
    "successor_receipt_head_digest": {
      "$ref": "#/$defs/digest"
    },
    "transaction_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "visible_buffer_disposition_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "plan_digest",
    "safepoint_certificate_digest",
    "transaction_receipt_digest",
    "restored_project_root",
    "restored_external_inventory_digest",
    "restored_reasoning_contract_digest",
    "restored_fixed_model_digest",
    "restored_reasoning_entry_digest",
    "raw_baseline_identity_digest",
    "raw_baseline_input_digest",
    "raw_decision_view_digest",
    "candidate_overlay_disposition_digest",
    "visible_buffer_disposition_digest",
    "prior_receipt_head_digest",
    "successor_receipt_head_digest",
    "restoration_verifier_identity_digest",
    "deoptimization_usage"
  ],
  "title": "RACC-R exact baseline restoration claim V1",
  "type": "object"
}
