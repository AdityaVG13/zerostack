{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.local/schemas/limits.schema.json",
  "title": "ZeroStack CodeMode Limits Echo v1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_logical_ops": {
      "type": "integer",
      "minimum": 1,
      "default": 1000
    },
    "max_physical_ops": {
      "type": "integer",
      "minimum": 1,
      "default": 256
    },
    "max_wall_ms": {
      "type": "integer",
      "minimum": 1,
      "default": 250
    },
    "hard_max_wall_ms": {
      "type": "integer",
      "minimum": 1,
      "default": 5000
    },
    "max_microtasks": {
      "type": "integer",
      "minimum": 1,
      "default": 4096
    },
    "max_memory_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 33554432
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 65536
    },
    "max_result_ref_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 10485760
    },
    "max_refs_emitted": {
      "type": "integer",
      "minimum": 1,
      "default": 256
    },
    "max_parallel_width": {
      "type": "integer",
      "minimum": 1,
      "default": 16
    },
    "max_code_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 65536
    }
  }
}
