{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/harness-report.schema.json",
  "title": "ZeroStack canonical conformance harness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ns",
    "bin",
    "contract_version",
    "surface",
    "completion_status",
    "passed",
    "checks"
  ],
  "properties": {
    "ns": {
      "enum": [
        "fz",
        "tz",
        "gz"
      ]
    },
    "bin": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "1.0"
    },
    "surface": {
      "enum": [
        "codemode",
        "mcp"
      ]
    },
    "completion_status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "passed",
          "status",
          "details"
        ],
        "properties": {
          "id": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7",
              "G8",
              "G9",
              "G10"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "skip_reason": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "skip_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "passed": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "passed": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G1"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G2"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G3"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G4"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G5"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G6"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G7"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G8"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G9"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "G10"
              }
            },
            "required": [
              "id"
            ]
          },
          "maxContains": 1
        }
      }
    }
  ]
}
