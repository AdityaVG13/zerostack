{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/racc-task-acceptance-receipt.schema.json",
  "title": "RACC TaskAcceptanceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "verifier_command_id", "verifier_environment_digest", "outcome", "exit_code", "expected_artifact_digests", "observed_artifact_digests", "journal_id", "attempt_cost"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "verifier_command_id": { "type": "integer", "minimum": 0 },
    "verifier_environment_digest": { "$ref": "#/$defs/digest" },
    "outcome": { "const": "passed" },
    "exit_code": { "const": 0 },
    "expected_artifact_digests": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/digest" } },
    "observed_artifact_digests": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/digest" } },
    "journal_id": { "$ref": "#/$defs/digest" },
    "attempt_cost": { "type": "integer", "minimum": 1 }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
