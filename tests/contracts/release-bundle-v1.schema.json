{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/release-bundle-v1.json",
  "title": "ZeroStack prebuilt release bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "platform", "source_heads", "artifacts", "entrypoints"],
  "properties": {
    "schema": { "const": "zerostack.release_bundle.v1" },
    "version": { "type": "string", "minLength": 1 },
    "platform": {
      "enum": ["darwin-arm64", "darwin-x86_64", "linux-arm64", "linux-x86_64", "windows-x86_64"]
    },
    "source_heads": {
      "type": "object",
      "required": ["ZeroStack", "FSZero", "GraphZero", "TokenZero"],
      "additionalProperties": false,
      "properties": {
        "ZeroStack": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "FSZero": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "GraphZero": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "TokenZero": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "executable": { "type": "boolean" }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[^/\\\\]+$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
      }
    }
  }
}
