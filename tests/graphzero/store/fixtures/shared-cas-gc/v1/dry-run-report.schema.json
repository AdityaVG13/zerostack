{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/shared-cas-gc/v1/dry-run-report.schema.json",
  "title": "ZeroStack shared-CAS GC dry-run report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "store_root",
    "evaluated_at",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "zerostack.cas-gc.legacy"
    },
    "record_type": {
      "const": "dry-run-report"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "store_root": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blob_hash",
          "verdict",
          "reason_codes",
          "evidence"
        ],
        "properties": {
          "blob_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "retain",
              "collect",
              "retain-uncertain"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "reachability-root",
                "pin",
                "active-lease",
                "stale-lease-grace",
                "shared-root",
                "unknown-version",
                "corrupt-metadata",
                "uncertain-metadata",
                "unpublished-temp",
                "namespace-isolation",
                "no-live-reference"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
