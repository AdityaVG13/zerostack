{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/shared-cas-gc/v1/reachability-snapshot.schema.json",
  "title": "ZeroStack shared-CAS reachability snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "engine",
    "project_id",
    "epoch",
    "published_at",
    "blob_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "zerostack.cas-gc.legacy"
    },
    "record_type": {
      "const": "reachability-snapshot"
    },
    "engine": {
      "enum": [
        "tokenzero",
        "fszero",
        "graphzero"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "blob_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
