{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphZero real-task reading-set eval task",
  "type": "object",
  "required": ["id", "repo", "change", "target_symbol", "success_files", "graph_guided_files", "unguided_candidate_files", "outcome"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "change": {"type": "string", "minLength": 1},
    "target_symbol": {"type": "string", "minLength": 1},
    "success_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "graph_guided_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "graph_guided_globs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unguided_candidate_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unguided_candidate_globs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outcome": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
