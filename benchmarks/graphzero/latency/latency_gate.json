{
  "schema_version": 1,
  "corpus": {
    "name": "graphzero",
    "min_rust_files": 200,
    "generator": "scripts/benchmark_driver.py corpus_info() counts repo *.rs files excluding target/.zerostack"
  },
  "thresholds": {
    "orient_symbol": {
